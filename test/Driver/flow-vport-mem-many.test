# Past the kernel's 256 (32 parts): refused.
# RUN: python3 %S/Inputs/flow/vport_stub.py 257 %t/g257
# RUN: not python3 %foldsim_tools/flow/v80/vmem_ports.py --sim-vh %t/g257/foldsim_sim.vh --mem-ports 1 --vmem-masters 8 2>&1 | FileCheck %s --check-prefix=MAX
# VH: {{^}}`define FOLDSIM_VMEM_MASTERS 8{{$}}
# VH: {{^}}`define FOLDSIM_VPORT_REPEAT7(f,s) `s `f(56) `s `f(57) `s `f(58) `s `f(59) `s `f(60) `s `f(61) `s `f(62) `s `f(63){{$}}
# VH-NEXT: {{^}}`define FOLDSIM_VPORT_REPEAT8(f,s) `s `f(64) `s `f(65) `s `f(66) `s `f(67) `s `f(68) `s `f(69){{$}}
# VH-NOT: FOLDSIM_VPORT_REPEAT9
# LINT: %Warning-DECLFILENAME: Filename 'foldsim_token'
# LINT-NEXT: %Warning-UNUSEDSIGNAL: Signal is not used: 'advance'
# LINT-NOT: %
# N70: {{^}}70{{$}}
# ONE: {{^}}1{{$}}
# N8: {{^}}8{{$}}
# MAX: vmem_ports.py: 257 static ports; the kernel lists at most 256
