# RUN: grep -o 'hw.instance "vport69" @foldsim_vport' %t/afu.mlir | wc -l | FileCheck %s --check-prefix=ONE
# RUN: grep -o 'hw.instance "g_vmem_master_[0-9]*.share" @foldsim_vmem_share' %t/afu.mlir | wc -l | FileCheck %s --check-prefix=N8
# The same ports of 128 MiB: a vmem space of 8.75 GiB (past 4 GiB: VMEM_BYTES_HI) lints as clean.
# RUN: python3 %S/Inputs/flow/vport_stub.py 70 %t/g8 1 134217728
# RUN: python3 %foldsim_tools/foldsim_flow.py kernel-vh --manifest %t/plain.toml --gen %t/g8 --vmem-masters 8 -o %t/g8/foldsim_kernel.vh
# RUN: python3 %foldsim_tools/foldsim_flow.py afu --manifest %t/plain.toml --gen %t/g8 --rtl-dir %S/../../shell/rtl -o %t/g8/foldsim_afu.sv
