# A copy of two instances passed in a ring order keeps each register in a
# ring of two flops: the head is the evaluated instance's state and a state
# pass rotates it, with no store and no instance select. Deeper copies and
# --register-state-entries 0 keep the state in distributed RAM. Three leaves:
# Leaf:2 gives a copy of two and one of one, Leaf:1 one copy of three (four
# entries).
# RUN: rm -rf %t && cd %S/Inputs/three
# RUN: foldsim --srcs top.f --top Top --out %t/two --static --copies Leaf:2 Leaf > /dev/null 2>&1
# RUN: FileCheck %s --check-prefix=TWO < %t/two/foldsim_sim.sv
# RUN: foldsim --srcs top.f --top Top --out %t/off --static --copies Leaf:2 --register-state-entries 0 Leaf > /dev/null 2>&1
# RUN: FileCheck %s --check-prefix=OFF < %t/off/foldsim_sim.sv
# RUN: foldsim --srcs top.f --top Top --out %t/deep --static --copies Leaf:1 Leaf > /dev/null 2>&1
# RUN: FileCheck %s --check-prefix=OFF < %t/deep/foldsim_sim.sv
# TWO-NOT: ram_style = "registers"
# TWO: reg  [7:0] q_ring0;
# TWO-NEXT: reg  [7:0] q_ring1;
# TWO: q_ring0 <= region0_state ? q_ring1 : q_ring0;
# TWO-NEXT: q_ring1 <= region0_state ? {{.*}} : q_ring1;
# OFF-NOT: ram_style = "registers"
# OFF-NOT: _ring0
