# --class-at TAG@GLOB makes the instances whose path matches a class, one
# module per parameter set: here `p`'s leaves, two of `Leaf #(8)` and one of
# `Leaf #(4)`, while `q`, another instance of the same `Pair`, keeps its own
# leaves in its parent's logic (its `Pair` is no longer the one `p` uses).
# RUN: rm -rf %t && cd %S/Inputs/class-at && foldsim --srcs top.f --top Top --out %t --class-at 'leaf@p.l*' 2>&1 | FileCheck %s --check-prefix=LOG
# RUN: FileCheck %s < %t/foldsim_sim.json
# RUN: FileCheck %s --check-prefix=IR < %t/design.mlir
# LOG: class-at leaf: leaf_0 (Leaf) x2
# LOG: class-at leaf: leaf_1 (Leaf_0) x1
# CHECK: "threads": {
# CHECK-NEXT: "leaf_0": 2,
# CHECK-NEXT: "leaf_1": 1,
# CHECK-NEXT: "Top_model": 1
# IR-LABEL: hw.module private @Pair(
# IR: hw.instance "l0" @Leaf(
# IR: hw.instance "l2" @Leaf_0(
# IR-LABEL: hw.module @Top(
# IR: hw.instance "p" @Pair__at0(
# IR: hw.instance "q" @Pair(
# IR-LABEL: hw.module private @Pair__at0(
# IR: hw.instance "l0" @leaf_0(
# IR: hw.instance "l1" @leaf_0(
# IR: hw.instance "l2" @leaf_1(

# One parameter set takes the tag's name, two tags of one parameter set are
# two modules, and a fused class may name them (each `l0` drives its `l1`);
# the first glob that matches takes an instance; a statically scheduled fold.
# RUN: rm -rf %t && cd %S/Inputs/class-at && foldsim --srcs top.f --top Top --out %t --static --class-at 'two@*.l1' --class-at 'one@*.l[01]' 'one+two' 2>&1 | FileCheck %s --check-prefix=FUSED
# FUSED: class-at one: one (Leaf) x2
# FUSED: class-at two: two (Leaf) x2
# FUSED: foldsim-fold-static: II =
# FUSED: one_two x2

# A glob that matches nothing is noted, so that one list serves several
# configurations; a tag that names a module of the design is refused.
# RUN: foldsim --srcs %S/Inputs/class-at/top.f --top Top --out %t/none --class-at 'x@nope.*' --class-at 'leaf@q.l2' 2>&1 | FileCheck %s --check-prefix=NONE
# NONE: class-at x: no instance matches nope.*
# NONE: class-at leaf: leaf (Leaf_0) x1
# RUN: not foldsim --srcs %S/Inputs/class-at/top.f --top Top --out %t/bad --class-at 'Pair@p' 2>&1 | FileCheck %s --check-prefix=BAD
# BAD: --class-at Pair: a module of the design has that name
