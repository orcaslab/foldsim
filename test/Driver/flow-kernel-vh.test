# foldsim_flow.py kernel-vh: the kernel shell's header from a manifest's
# [platform]: memory ports (8 a line), channel shift, AXI id width and
# speculation depth, then the kernel's own vmem_ports.py output. A port count
# the kernel does not build fails.
# RUN: rm -rf %t && mkdir -p %t
# RUN: python3 %foldsim_tools/foldsim_flow.py kernel-vh --manifest %S/Inputs/flow/axi16.toml --sim-vh /dev/null --vmem-ports %S/Inputs/flow/vmem_none.py | FileCheck %s --match-full-lines --strict-whitespace
# RUN: sed 's/mem_ports = 16/mem_ports = 3/' %S/Inputs/flow/axi16.toml > %t/three.toml
# RUN: not python3 %foldsim_tools/foldsim_flow.py kernel-vh --manifest %t/three.toml --sim-vh /dev/null --vmem-ports %S/Inputs/flow/vmem_none.py 2>&1 | FileCheck %s --check-prefix=THREE
# CHECK:// Generated by foldsim_flow.py kernel-vh. Do not edit.
# CHECK-NEXT:`define FOLDSIM_MEM_PORTS 16
# CHECK-NEXT:`define FOLDSIM_MEM_CH_SHIFT 0
# CHECK-NEXT:`define FOLDSIM_MEM_ID_W 8
# CHECK-NEXT:`define FOLDSIM_MEM_REPEAT0(f,s) `f(0) `s `f(1) `s `f(2) `s `f(3) `s `f(4) `s `f(5) `s `f(6) `s `f(7)
# CHECK-NEXT:`define FOLDSIM_MEM_REPEAT1(f,s) `s `f(8) `s `f(9) `s `f(10) `s `f(11) `s `f(12) `s `f(13) `s `f(14) `s `f(15)
# CHECK-NEXT:`define FOLDSIM_MEM_REPEAT2(f,s) 
# CHECK-NEXT:`define FOLDSIM_MEM_REPEAT3(f,s) 
# CHECK-NEXT:`define FOLDSIM_MEM_SPEC 2
# THREE: kernel-vh: [platform] mem_ports 3: the kernel has 1, 2, 4, 8, 16 or 32 memory ports
