# REQUIRES: toml
# foldsim_flow.py kernel-vh: the kernel shell's header from a manifest's
# [platform]: memory ports, channel shift, AXI id width, their device-memory
# masters (one per port; one where the simulator folds its ports) repeated 8 a
# line, the speculation depth, then vmem_ports.py's (here no virtual memory).
# A port count the kernel does not build fails. cfg: one linker master each.
# RUN: rm -rf %t && mkdir -p %t
# RUN: python3 %foldsim_tools/foldsim_flow.py kernel-vh --manifest %S/Inputs/flow/axi16.toml --gen %S/Inputs/flow/gen16 | FileCheck %s --match-full-lines --strict-whitespace
# RUN: python3 %foldsim_tools/foldsim_flow.py kernel-vh --manifest %S/Inputs/flow/axi16.toml --gen %S/Inputs/flow/genpf | FileCheck %s --check-prefix=FOLD
# RUN: python3 %foldsim_tools/foldsim_flow.py cfg --manifest %S/Inputs/flow/axi16.toml --gen %S/Inputs/flow/genpf | FileCheck %s --check-prefix=CFG
# RUN: sed 's/mem_ports = 16/mem_ports = 3/' %S/Inputs/flow/axi16.toml > %t/three.toml
# RUN: not python3 %foldsim_tools/foldsim_flow.py kernel-vh --manifest %t/three.toml --gen %S/Inputs/flow/gen16 2>&1 | FileCheck %s --check-prefix=THREE
# CHECK:// Generated by foldsim_flow.py kernel-vh. Do not edit.
# CHECK-NEXT:`define FOLDSIM_MEM_PORTS 16
# CHECK-NEXT:`define FOLDSIM_MEM_CH_SHIFT 0
# CHECK-NEXT:`define FOLDSIM_MEM_ID_W 8
# CHECK-NEXT:`define FOLDSIM_MEM_MASTERS 16
# CHECK-NEXT:`define FOLDSIM_MEM_REPEAT0(f,s) `f(0) `s `f(1) `s `f(2) `s `f(3) `s `f(4) `s `f(5) `s `f(6) `s `f(7)
# CHECK-NEXT:`define FOLDSIM_MEM_REPEAT1(f,s) `s `f(8) `s `f(9) `s `f(10) `s `f(11) `s `f(12) `s `f(13) `s `f(14) `s `f(15)
# CHECK-NEXT:`define FOLDSIM_MEM_REPEAT2(f,s) 
# CHECK-NEXT:`define FOLDSIM_MEM_REPEAT3(f,s) 
# CHECK-NEXT:`define FOLDSIM_MEM_SPEC 2
# FOLD: `define FOLDSIM_MEM_MASTERS 1
# FOLD-NEXT: `define FOLDSIM_MEM_REPEAT0(f,s) `f(0)
# CFG: # Generated by gen_platform.py from v80.toml. Do not edit.
# CFG: nk=foldsim_afu:1:foldsim_afu_0
# CFG-NEXT: sp=foldsim_afu_0.m_axi_mem_0:MEM
# CFG-NOT: m_axi_mem_1
# CFG: freqhz=300000000
# THREE: foldsim_flow: [platform] mem_ports 3: the kernel has 1, 2, 4, 8, 16 or 32 memory ports
