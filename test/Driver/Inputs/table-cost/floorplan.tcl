# Generated by foldsim. Do not edit.
set c [get_cells -quiet -hierarchical foldsim_slr0]
if {[llength $c] == 1} { set_property USER_SLR_ASSIGNMENT SLR2 $c }
set c [get_cells -quiet -hierarchical foldsim_slr1]
if {[llength $c] == 1} { set_property USER_SLR_ASSIGNMENT SLR1 $c }
# The simulator level and its environment with group 0 (--slr-level).
set g [get_cells -quiet -hierarchical foldsim_slr0]
if {[llength $g] == 1} {
  set sim [get_property PARENT $g]
  set c [get_cells -quiet -filter {NAME !~ "*/foldsim_slr*"} $sim/*]
  if {[llength $c] > 0} { set_property USER_SLR_ASSIGNMENT SLR2 $c }
  set e [get_cells -quiet [get_property PARENT [get_cells $sim]]/env]
  if {[llength $e] == 1} { set_property USER_SLR_ASSIGNMENT SLR2 $e }
}
