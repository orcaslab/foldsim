# A target manifest (--manifest) gives the driver's options: the same options as
# the command line it stands for, the command line overriding any of it (a list
# option or the positional classes replacing the manifest's list), and the
# same simulator. from-argv writes the manifest of a command line; get prints a
# key for a flow. Keys that are no option, and values of the wrong kind, fail.
# RUN: rm -rf %t && mkdir -p %t && cd %S/Inputs/tree-arb
# RUN: foldsim --srcs %S/Inputs/tree-arb/top.f --top Top --out %t/g --static --zero-latency-links --zero-latency-chains --class-at 'sl@*.slice' --class-at 'root@inner:arb' --class-at 'root@inner:*.join_arb' 'root+Bank' --manifest-dump > %t/flags.json
# RUN: foldsim --manifest %S/Inputs/manifest/tree-arb.toml --out %t/g --manifest-dump > %t/manifest.json
# RUN: diff %t/flags.json %t/manifest.json
# RUN: FileCheck %s --check-prefix=DUMP < %t/manifest.json
# DUMP: "class_at": [
# DUMP-NEXT: "sl@*.slice",
# DUMP-NEXT: "root@inner:arb",
# DUMP-NEXT: "root@inner:*.join_arb"
# DUMP: "classes": [
# DUMP-NEXT: "root+Bank"
# DUMP: "srcs": "{{.*}}/Inputs/tree-arb/top.f",
# DUMP: "static": true,
# DUMP: "top": "Top",
#
# Overrides: a scalar, a repeated option (the whole list) and the classes.
# RUN: foldsim --manifest %S/Inputs/manifest/tree-arb.toml --out %t/g --channel-depth 3 --class-at 'b@*.out_buf' Bank --manifest-dump | FileCheck %s --check-prefix=OVR
# OVR: "channel_depth": 3,
# OVR: "class_at": [
# OVR-NEXT: "b@*.out_buf"
# OVR-NEXT: ],
# OVR: "classes": [
# OVR-NEXT: "Bank"
# OVR-NEXT: ],
#
# The simulators: generated by the flags, then by the manifest into the same
# directory, byte for byte the same.
# RUN: foldsim --srcs %S/Inputs/tree-arb/top.f --top Top --out %t/g --static --zero-latency-links --zero-latency-chains --class-at 'sl@*.slice' --class-at 'root@inner:arb' --class-at 'root@inner:*.join_arb' 'root+Bank' > /dev/null 2>&1
# RUN: cp %t/g/schedule.txt %t/flags.schedule.txt && cp %t/g/foldsim_sim.sv %t/flags.sim.sv
# RUN: foldsim --manifest %S/Inputs/manifest/tree-arb.toml --out %t/g 2>&1 | FileCheck %s --check-prefix=GEN
# RUN: cmp %t/flags.schedule.txt %t/g/schedule.txt
# RUN: cmp %t/flags.sim.sv %t/g/foldsim_sim.sv
# GEN: foldsim: Top_model x1, sl x6, root_Bank x1
#
# from-argv: the manifest of the command line gives the same options again.
# RUN: python3 %foldsim_tools/foldsim_manifest.py from-argv --name tree-arb -- --srcs %S/Inputs/tree-arb/top.f --top Top --static --zero-latency-links --zero-latency-chains --class-at 'sl@*.slice' --class-at 'root@inner:arb' --class-at 'root@inner:*.join_arb' 'root+Bank' > %t/rt.toml
# RUN: FileCheck %s --check-prefix=RT < %t/rt.toml
# RUN: foldsim --manifest %t/rt.toml --out %t/g --manifest-dump > %t/rt.json
# RUN: diff %t/flags.json %t/rt.json
# RT: [design]
# RT-NEXT: name = "tree-arb"
# RT-NEXT: top = "Top"
# RT: [classes]
# RT-NEXT: at = [
# RT-NEXT:   "sl@*.slice",
#
# get: a flow key, a list joined by spaces.
# RUN: python3 %foldsim_tools/foldsim_manifest.py get %S/Inputs/manifest/tree-arb.toml classes.at | FileCheck %s --check-prefix=GET
# RUN: python3 %foldsim_tools/foldsim_manifest.py get %S/Inputs/manifest/tree-arb.toml flow.clock | FileCheck %s --check-prefix=CLK
# GET: sl@*.slice root@inner:arb root@inner:*.join_arb
# CLK: clk
#
# A rewritten source: the copy imported, the original untouched; ${VAR} from --manifest-var.
# RUN: foldsim --manifest %S/Inputs/manifest/rewrite.toml --manifest-var TREE=%S/Inputs/tree-arb --out %t/rw > %t/rw.log 2>&1
# RUN: FileCheck %s --check-prefix=RW < %t/rw/rewritten/top.sv
# RUN: FileCheck %s --check-prefix=RWLOG < %t/rw.log
# RW: // REWRITTEN arbiter tree over eight requesters
# RWLOG: circt-verilog {{.*}}/rw/rewritten/top.sv
#
# Errors.
# RUN: not foldsim --manifest %S/Inputs/manifest/bad-key.toml --out %t/e 2>&1 | FileCheck %s --check-prefix=KEY
# RUN: not foldsim --manifest %S/Inputs/manifest/bad-switch.toml --out %t/e 2>&1 | FileCheck %s --check-prefix=SWITCH
# RUN: not foldsim --manifest %S/Inputs/manifest/rewrite-missing.toml --out %t/e 2>&1 | FileCheck %s --check-prefix=MISSING
# RUN: not foldsim --manifest %S/Inputs/manifest/rewrite.toml --out %t/e 2>&1 | FileCheck %s --check-prefix=VAR
# RUN: not foldsim --manifest %S/Inputs/manifest/tree-arb.toml 2>&1 | FileCheck %s --check-prefix=OUT
# KEY: [options] zero_latency_link: no driver option zero_latency_link
# SWITCH: [options] static: --static is a switch (true or false)
# MISSING: --rewrite {{.*}}top.sv: no 'no such text' in it
# VAR: ${TREE} is not set (--manifest-var TREE=...)
# OUT: --out is required (on the command line or in the manifest)
