# RUN: FileCheck %s --check-prefix=FH < %t/fh.log
# RUN: %verilator --binary --timing -Wno-fatal -Wno-lint --top-module tb -I%t/fh -DVM1 -DVM2 -Mdir %t/fh/obj %S/Inputs/tb_pages.sv top.sv %t/fh/foldsim_sim.sv > %t/fh/build.log 2>&1
# RUN: %t/fh/obj/Vtb +verilator+rand+reset+0 +verilator+seed+1 +lo=1 | FileCheck %s
# RUN: %t/fh/obj/Vtb +verilator+rand+reset+0 +verilator+seed+3 +lo=5 +hi=60 +full=30 | FileCheck %s
# RUN: env FOLDSIM_PP_ROWS=balanced foldsim --srcs top.f --top Top --out %t/fhb --static --state-in-ram Leaf::3 --state-in-ram-pp --state-scratch-bits 0 --bubbles --modulo Leaf > %t/fhb.log 2>&1
# RUN: %verilator --binary --timing -Wno-fatal -Wno-lint --top-module tb -I%t/fhb -DBUBBLES -Mdir %t/fhb/obj %S/Inputs/tb_pages.sv top.sv %t/fhb/foldsim_sim.sv > %t/fhb/build.log 2>&1
# RUN: %t/fhb/obj/Vtb +verilator+rand+reset+0 +verilator+seed+4 +lo=1 +hi=40 +stall=20 +bubble=20 | FileCheck %s
# The folded pipelines' stores take the scratch first: on chip under the default scratch, in HBM past it.
# RUN: foldsim --srcs top.f --top Top --out %t/fs --static --fold-store-hbm 1 Leaf 2>&1 | FileCheck %s --check-prefix=FS
# RUN: foldsim --srcs top.f --top Top --out %t/fs1 --static --fold-store-hbm 1 --state-scratch-bits 120 Leaf 2>&1 | FileCheck %s --check-prefix=FS1

# P2LOG: state-scratch: Leaf: 4 of 4 instances' PP rows (1152 bits) stream from HBM, 0 resident
# P2LOG: state-scratch: 0 bits; fold stores 0, rows resident 0 (0 kept on chip by rule or form), streamed 1152 in 1 classes
# P2LOG: state-stream: Leaf: P 2, 4 of 4 instances streamed, a window of 2 slots
# P2LOG: state-stream: II_sched [[II:[0-9]+]], HBM state bits a frame [[B:[0-9]+]] (busiest master [[B]]), II_bw {{[0-9]+}} (8 masters, 8192 b/hc usable): II [[II]]
# P2LOG: state-stream: Leaf: {{[0-9]+}} columns in 1 virtual memories, a window of 2 slots x 2 rows
# P2LOG: state-in-ram-pp: Leaf (rows in HBM, a window of 2 slots): built {{.*}} x 4 rows (block)
# A chunk's controller is as wide as its columns (3 x 72 bits), not a power of two.
# P2DW: `define FOLDSIM_VMEM_0_DW 216
# P2VH: `define FOLDSIM_VMEM_COUNT 1
# P2VH: `define FOLDSIM_VMEM_0_IW 3
# P2VH: `define FOLDSIM_VMEM_0_INSTANCES 8
# PART: state-scratch: Leaf: 2 of 4 instances' PP rows (1152 bits) stream from HBM, 2 resident
# PART: state-stream: Leaf: P 8, 2 of 4 instances streamed, a window of 1 slots
# C2: state-stream: Leaf: no landing window of at most 128 slots fits the schedule (II {{[0-9]+}}): its rows stay on chip
# C2: state-stream: Leaf_copy1: no landing window
# ON: state-scratch: auto {{[0-9]+}} bits
# ON: state-scratch: {{[0-9]+}} bits; fold stores 0, rows resident {{[0-9]+}} (0 kept on chip by rule or form), streamed 0 in 0 classes
# ON-NOT: state-stream:
# ONVH-NOT: FOLDSIM_VMEM_COUNT
# FH: fold-store-hbm: Leaf: 2 stores, 224 bits in HBM
# FS-NOT: fold-store-hbm:
# FS: state-scratch: {{[0-9]+}} bits; fold stores 224, rows resident 0
# FS1: fold-store-hbm: Leaf: 1 stores, {{[0-9]+}} bits in HBM
# CHECK: {{^}}MATCH 196 cycles
# CHECK-NOT: PROTOCOL
