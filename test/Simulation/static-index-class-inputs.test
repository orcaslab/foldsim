# RUN: %t/r/obj/Vtb +verilator+rand+reset+2 +verilator+seed+2 +lo=1 +hi=60 +stall=30 | FileCheck %s --check-prefix=S2
# RUN: %t/r/obj/Vtb +verilator+rand+reset+2 +verilator+seed+3 +lo=100 +hi=400 +stall=20 | FileCheck %s --check-prefix=S3
# RUN: foldsim --srcs top.f --top Top --out %t/p --static --nest --modulo --fold-ports 'mp_([0-9]+)_(.*)' --fold-ports-reset rst --index-class-inputs Unit Arb > %t/p.log 2>&1
# RUN: FileCheck %s --check-prefix=PLOG < %t/p.log
