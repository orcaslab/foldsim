# RUN: FileCheck %s --check-prefix=MUTLOG < %t/mut.log
# MUTLOG: slr-group-cut: {{[1-9][0-9]*}} values read by the groups from a lead-1 register
# RUN: %verilator --binary --timing -Wno-fatal -Wno-lint --x-initial unique --top-module tb -Mdir %t/mut/obj %S/Inputs/tb_late.sv top.sv %t/mut/foldsim_sim.sv > %t/mut/build.log 2>&1
