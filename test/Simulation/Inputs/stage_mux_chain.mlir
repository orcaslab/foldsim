hw.module @Leaf(in %clk : !seq.clock, in %reset : i1, in %c : i32, in %d : i256, out y : i8) {
  %z = hw.constant 0 : i8
  %r = seq.firreg %m0 clock %clk reset sync %reset, %z : i8
  %c0 = comb.extract %c from 0 : (i32) -> i1
  %d0 = comb.extract %d from 0 : (i256) -> i8
  %c1 = comb.extract %c from 1 : (i32) -> i1
  %d1 = comb.extract %d from 8 : (i256) -> i8
  %c2 = comb.extract %c from 2 : (i32) -> i1
  %d2 = comb.extract %d from 16 : (i256) -> i8
  %c3 = comb.extract %c from 3 : (i32) -> i1
  %d3 = comb.extract %d from 24 : (i256) -> i8
  %c4 = comb.extract %c from 4 : (i32) -> i1
  %d4 = comb.extract %d from 32 : (i256) -> i8
  %c5 = comb.extract %c from 5 : (i32) -> i1
  %d5 = comb.extract %d from 40 : (i256) -> i8
  %c6 = comb.extract %c from 6 : (i32) -> i1
  %d6 = comb.extract %d from 48 : (i256) -> i8
  %c7 = comb.extract %c from 7 : (i32) -> i1
  %d7 = comb.extract %d from 56 : (i256) -> i8
  %c8 = comb.extract %c from 8 : (i32) -> i1
  %d8 = comb.extract %d from 64 : (i256) -> i8
  %c9 = comb.extract %c from 9 : (i32) -> i1
  %d9 = comb.extract %d from 72 : (i256) -> i8
  %c10 = comb.extract %c from 10 : (i32) -> i1
  %d10 = comb.extract %d from 80 : (i256) -> i8
  %c11 = comb.extract %c from 11 : (i32) -> i1
  %d11 = comb.extract %d from 88 : (i256) -> i8
  %c12 = comb.extract %c from 12 : (i32) -> i1
  %d12 = comb.extract %d from 96 : (i256) -> i8
  %c13 = comb.extract %c from 13 : (i32) -> i1
  %d13 = comb.extract %d from 104 : (i256) -> i8
  %c14 = comb.extract %c from 14 : (i32) -> i1
  %d14 = comb.extract %d from 112 : (i256) -> i8
  %c15 = comb.extract %c from 15 : (i32) -> i1
  %d15 = comb.extract %d from 120 : (i256) -> i8
  %c16 = comb.extract %c from 16 : (i32) -> i1
  %d16 = comb.extract %d from 128 : (i256) -> i8
  %c17 = comb.extract %c from 17 : (i32) -> i1
  %d17 = comb.extract %d from 136 : (i256) -> i8
  %c18 = comb.extract %c from 18 : (i32) -> i1
  %d18 = comb.extract %d from 144 : (i256) -> i8
  %c19 = comb.extract %c from 19 : (i32) -> i1
  %d19 = comb.extract %d from 152 : (i256) -> i8
  %c20 = comb.extract %c from 20 : (i32) -> i1
  %d20 = comb.extract %d from 160 : (i256) -> i8
  %c21 = comb.extract %c from 21 : (i32) -> i1
  %d21 = comb.extract %d from 168 : (i256) -> i8
  %c22 = comb.extract %c from 22 : (i32) -> i1
  %d22 = comb.extract %d from 176 : (i256) -> i8
  %c23 = comb.extract %c from 23 : (i32) -> i1
  %d23 = comb.extract %d from 184 : (i256) -> i8
  %c24 = comb.extract %c from 24 : (i32) -> i1
  %d24 = comb.extract %d from 192 : (i256) -> i8
  %c25 = comb.extract %c from 25 : (i32) -> i1
  %d25 = comb.extract %d from 200 : (i256) -> i8
  %c26 = comb.extract %c from 26 : (i32) -> i1
  %d26 = comb.extract %d from 208 : (i256) -> i8
  %c27 = comb.extract %c from 27 : (i32) -> i1
  %d27 = comb.extract %d from 216 : (i256) -> i8
  %c28 = comb.extract %c from 28 : (i32) -> i1
  %d28 = comb.extract %d from 224 : (i256) -> i8
  %c29 = comb.extract %c from 29 : (i32) -> i1
  %d29 = comb.extract %d from 232 : (i256) -> i8
  %c30 = comb.extract %c from 30 : (i32) -> i1
  %d30 = comb.extract %d from 240 : (i256) -> i8
  %c31 = comb.extract %c from 31 : (i32) -> i1
  %d31 = comb.extract %d from 248 : (i256) -> i8
  %m32 = comb.xor %r, %d0 : i8
  %m31 = comb.mux %c31, %d31, %m32 : i8
  %m30 = comb.mux %c30, %d30, %m31 : i8
  %m29 = comb.mux %c29, %d29, %m30 : i8
  %m28 = comb.mux %c28, %d28, %m29 : i8
  %m27 = comb.mux %c27, %d27, %m28 : i8
  %m26 = comb.mux %c26, %d26, %m27 : i8
  %m25 = comb.mux %c25, %d25, %m26 : i8
  %m24 = comb.mux %c24, %d24, %m25 : i8
  %m23 = comb.mux %c23, %d23, %m24 : i8
  %m22 = comb.mux %c22, %d22, %m23 : i8
  %m21 = comb.mux %c21, %d21, %m22 : i8
  %m20 = comb.mux %c20, %d20, %m21 : i8
  %m19 = comb.mux %c19, %d19, %m20 : i8
  %m18 = comb.mux %c18, %d18, %m19 : i8
  %m17 = comb.mux %c17, %d17, %m18 : i8
  %m16 = comb.mux %c16, %d16, %m17 : i8
  %m15 = comb.mux %c15, %d15, %m16 : i8
  %m14 = comb.mux %c14, %d14, %m15 : i8
  %m13 = comb.mux %c13, %d13, %m14 : i8
  %m12 = comb.mux %c12, %d12, %m13 : i8
  %m11 = comb.mux %c11, %d11, %m12 : i8
  %m10 = comb.mux %c10, %d10, %m11 : i8
  %m9 = comb.mux %c9, %d9, %m10 : i8
  %m8 = comb.mux %c8, %d8, %m9 : i8
  %m7 = comb.mux %c7, %d7, %m8 : i8
  %m6 = comb.mux %c6, %d6, %m7 : i8
  %m5 = comb.mux %c5, %d5, %m6 : i8
  %m4 = comb.mux %c4, %d4, %m5 : i8
  %m3 = comb.mux %c3, %d3, %m4 : i8
  %m2 = comb.mux %c2, %d2, %m3 : i8
  %m1 = comb.mux %c1, %d1, %m2 : i8
  %m0 = comb.mux %c0, %d0, %m1 : i8
  hw.output %r : i8
}
hw.module @Top(in %clk : !seq.clock, in %reset : i1, in %c : i32, in %d : i256, out y0 : i8, out y1 : i8) {
  %l0.y = hw.instance "l0" @Leaf(clk: %clk : !seq.clock, reset: %reset : i1, c: %c : i32, d: %d : i256) -> (y : i8)
  %l1.y = hw.instance "l1" @Leaf(clk: %clk : !seq.clock, reset: %reset : i1, c: %c : i32, d: %d : i256) -> (y : i8)
  hw.output %l0.y, %l1.y : i8, i8
}
