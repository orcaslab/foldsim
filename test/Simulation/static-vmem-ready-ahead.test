# REQUIRES: verilator
# --ready-ahead: the pending-read bits a frame's position waits on are read a
# host cycle ahead, into registers, at the instance the lookahead register
# takes next and from the bits' next value (this host cycle's issue sets, its
# answer clears). The decision is then an AND of registers; the values are the
# same, so the simulator matches the target and takes exactly as many host
# cycles as without the option at the same response timing (one copy, two
# copies, nested sequencers, bubbles). The classes' bubble registers are kept
# apart (`keep`) so that each sits by its own slot tables.
# RUN: rm -rf %t && mkdir -p %t && cd %S/../Driver/Inputs/vmem
# RUN: foldsim --srcs top.f --top Top --out %t/one --static --virtual-memories ram --ready-ahead Leaf > /dev/null 2>&1
# RUN: FileCheck %s --check-prefix=IR < %t/one/foldsim_sim.mlir
# IR: %ram_pending_ahead = seq.firreg {{%[^ ]+}} clock %hostClock reset sync %hostReset
# RUN: %verilator --binary --timing -Wno-fatal -Wno-lint --top-module tb -Mdir %t/one/obj %S/Inputs/tb_vmem.sv top.sv %t/one/foldsim_sim.sv > %t/one/build.log 2>&1
# RUN: %t/one/obj/Vtb +verilator+rand+reset+0 +verilator+seed+1 +lo=1 | FileCheck %s --check-prefix=FAST
# RUN: %t/one/obj/Vtb +verilator+rand+reset+0 +verilator+seed+2 +lo=1 +hi=30 +stall=20 > %t/one/s2.txt
# RUN: FileCheck %s < %t/one/s2.txt
# RUN: %t/one/obj/Vtb +verilator+rand+reset+0 +verilator+seed+3 +lo=5 +hi=60 +full=30 | FileCheck %s
# The same response timing without the option: the same host cycles.
# RUN: foldsim --srcs top.f --top Top --out %t/base --static --virtual-memories ram Leaf > /dev/null 2>&1
# RUN: %verilator --binary --timing -Wno-fatal -Wno-lint --top-module tb -Mdir %t/base/obj %S/Inputs/tb_vmem.sv top.sv %t/base/foldsim_sim.sv > %t/base/build.log 2>&1
# RUN: %t/base/obj/Vtb +verilator+rand+reset+0 +verilator+seed+2 +lo=1 +hi=30 +stall=20 > %t/base/s2.txt
# RUN: grep MATCH %t/base/s2.txt > %t/base/m2.txt
# RUN: grep MATCH %t/one/s2.txt > %t/one/m2.txt
# RUN: diff %t/base/m2.txt %t/one/m2.txt
# RUN: foldsim --srcs top.f --top Top --out %t/copies --static --virtual-memories ram --ready-ahead --copies Leaf:2 Leaf > /dev/null 2>&1
# RUN: %verilator --binary --timing -Wno-fatal -Wno-lint --top-module tb -DCOPIES2 -DIW=1 -Mdir %t/copies/obj %S/Inputs/tb_vmem.sv top.sv %t/copies/foldsim_sim.sv > %t/copies/build.log 2>&1
# RUN: %t/copies/obj/Vtb +verilator+rand+reset+0 +verilator+seed+4 +lo=1 +hi=40 +stall=30 +full=10 | FileCheck %s
# RUN: foldsim --srcs top.f --top Top --out %t/nest --static --virtual-memories ram --ready-ahead --nest --bubbles Leaf > /dev/null 2>&1
# RUN: FileCheck %s --check-prefix=KEEP < %t/nest/foldsim_sim.mlir
# KEEP: %Leaf_bubble = seq.firreg {{.*}} {sv.attributes = [#sv.attribute<"keep" = "\22true\22">]} : i1
# RUN: %verilator --binary --timing -Wno-fatal -Wno-lint --top-module tb -DBUBBLES -Mdir %t/nest/obj %S/Inputs/tb_vmem.sv top.sv %t/nest/foldsim_sim.sv > %t/nest/build.log 2>&1
# RUN: %t/nest/obj/Vtb +verilator+rand+reset+0 +verilator+seed+7 +lo=1 +hi=30 +bubble=30 +stall=10 | FileCheck %s
# RUN: %t/nest/obj/Vtb +verilator+rand+reset+0 +verilator+seed+8 +lo=1 +hi=30 +bubble=95 +burst=16 +stall=10 | FileCheck %s
# FAST: {{^}}MATCH 196 cycles in 2000 host cycles, H 10.00
# CHECK: {{^}}MATCH
