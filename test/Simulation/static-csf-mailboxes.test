# RUN: %verilator --binary --timing -Wno-fatal -Wno-lint --x-initial unique --top-module tb -Mdir %t/slr/obj %S/Inputs/tb_reset.sv top.sv %t/slr/foldsim_sim.sv > %t/slr/build.log 2>&1
