# RUN: %t/rows2/obj/Vtb +verilator+rand+reset+2 +verilator+seed+8 +bubble=50 +stall=50 +lo=1 +hi=600 +full=30 | FileCheck %s
# RUN: foldsim --srcs top.f --top Top --out %t/rows2e --static --no-drop-dead-inputs --no-staged-link-direct --nest --modulo --bubbles --min-ii 256 --link-kinds Unit:Reader:hbm,Reader:Unit:hbm --link-hbm-beat-bits 16 --page-engines 4 --link-hbm-beat-rows Unit Reader > %t/rows2e.log 2>&1
# RUN: %verilator --binary --timing -Wno-fatal -Wno-lint --x-initial unique --top-module tb -I%t/rows2e -DVM1 -DBUBBLES -Mdir %t/rows2e/obj %S/Inputs/tb_linkhbm.sv top.sv %t/rows2e/foldsim_sim.sv > %t/rows2e/build.log 2>&1
# RUN: %t/rows2e/obj/Vtb +verilator+rand+reset+2 +verilator+seed+6 +bubble=30 +stall=30 +lo=1 +hi=30 +full=20 | FileCheck %s
