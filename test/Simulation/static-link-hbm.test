# RUN: foldsim --srcs top.f --top Top --out %t/rows3 --static --no-drop-dead-inputs --no-staged-link-direct --nest --modulo --bubbles --min-ii 256 --link-kinds Unit:Reader:hbm,Reader:Unit:hbm --link-hbm-beat-bits 11 --link-hbm-beat-rows Unit Reader > %t/rows3.log 2>&1
