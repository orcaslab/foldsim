# RUN: diff %t/own0/r2.txt %t/own/r2.txt
# The groups' HBM ports by linker tag (foldsim_sp.txt) from a region that
# names them (the asl9 any-SLR shell): a group's memory masters bind to its
# own SLR's ports; the level (group 2 here, SLR0) with its SLR's.
# RUN: foldsim --srcs top.f --top Top --out %t/sp --static --nest --bubbles --copies Leaf:3 --zero-latency-links --zero-latency-chains --slr-groups --slr-region %foldsim_tools/foldsim_v80_asl9_slr.json --slr-assign Leaf:0,Leaf_copy1:1,Leaf_copy2:1,Top_model:2 --slr-level 2 Leaf > /dev/null 2>&1
# RUN: FileCheck %s --check-prefix=SP < %t/sp/foldsim_sp.txt
# SP: group 0 SLR2 MEM
# SP-NEXT: group 1 SLR1 MEM_SLR1_0 MEM_SLR1_1 MEM_SLR1_2 MEM_SLR1_3
# SP-NEXT: group 2 SLR0 MEM_SLR0_0 MEM_SLR0_1 MEM_SLR0_2 MEM_SLR0_3
# SP-NEXT: level SLR0 MEM_SLR0_0 MEM_SLR0_1 MEM_SLR0_2 MEM_SLR0_3
# RUN: not test -e %t/own/foldsim_sp.txt
# --slr-sites from an SLL check's sll.json: the copies' measured LUTs, and its
# simulator level with the kernel (`top`) kept from the --slr-level group's
# room; --slr-fill: the fraction of each SLR a group may fill.
# RUN: echo '{"copies": {"Leaf": {"lut": 10}, "Top_model": {"lut": 5}}, "top": {"lut": 100000}}' > %t/sites.json
# RUN: foldsim --srcs top.f --top Top --out %t/fill --static --nest --bubbles --copies Leaf:3 --zero-latency-links --zero-latency-chains --slr-groups --slr-region v80 --slr-fill 0.5 --slr-sites %t/sites.json --slr-level 1 --slr-assign Leaf:0,Leaf_copy1:1,Leaf_copy2:1,Top_model:2 Leaf > %t/fill.log 2>&1
# RUN: FileCheck %s --check-prefix=FILL < %t/fill.log
# FILL: SLR group 1 (SLR1) keeps {{[1-9][0-9]+}} LUT sites for the simulator level and the kernel
# FILL: 3 SLR groups of at most SLR2 {{[0-9]+}}, SLR1 {{[0-9]+}}, SLR0 {{[0-9]+}} LUT sites; copies: Leaf {{[0-9]+}}
# With the kernel's part of `top` (`top_kernel`, the SLL check's): the level
# alone kept from the level's group, the kernel spread over the SLRs by their
# LUTs, as the check charges them; the check itself puts the level in the SLR
# the floorplan pins it to (--slr-level), not spread.
# RUN: echo '{"copies": {"Leaf": {"lut": 10}, "Top_model": {"lut": 5}}, "top": {"lut": 100000}, "top_kernel": {"lut": 40000}}' > %t/lvl.json
# RUN: foldsim --srcs top.f --top Top --out %t/lvl --static --nest --bubbles --copies Leaf:3 --zero-latency-links --zero-latency-chains --slr-groups --slr-region v80 --slr-sites %t/lvl.json --slr-level 1 --slr-assign Leaf:0,Leaf_copy1:1,Leaf_copy2:1,Top_model:2 Leaf > %t/lvl.log 2>&1
# RUN: FileCheck %s --check-prefix=LVL < %t/lvl.log
# LVL: SLR group 1 (SLR1) keeps 87300 LUT sites for the simulator level (measured
# LVL: the kernel beside the simulator (40000 LUTs, measured) spread over the SLRs by their LUTs
# RUN: FileCheck %s --check-prefix=LVLCHK < %t/lvl/sll/sll.txt
# LVLCHK: simulator level (in SLR1, the kernel spread):
# With the sll.json's URAM288 / RAMB36 (tenths) the chooser keeps each
# group within its SLR's RAM at the region's margin too: a copy past every
# SLR's URAM finds no assignment.
# RUN: echo '{"copies": {"Leaf": {"lut": 10, "uram": 1, "bram": 2}, "Top_model": {"lut": 5, "uram": 0, "bram": 1}}, "top": {"lut": 1000, "uram": 0, "bram": 3}}' > %t/rams.json
# RUN: foldsim --srcs top.f --top Top --out %t/rams --static --nest --bubbles --copies Leaf:3 --zero-latency-links --zero-latency-chains --slr-groups --slr-region v80 --slr-sites %t/rams.json --slr-level 0 Leaf > %t/rams.log 2>&1
# RUN: FileCheck %s --check-prefix=RAMS < %t/rams.log
# RAMS: SLR groups' URAM288 / RAMB36 (tenths) at most SLR2 4216/8258, SLR1 4344/8874, SLR0 1734/3366
# RAMS: slr-capacities={{[0-9]+}}/4216/8258,{{[0-9]+}}/4344/8874,{{[0-9]+}}/1734/3366 slr-sites=Leaf:{{[0-9]+}}/10/20
