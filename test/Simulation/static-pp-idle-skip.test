# RUN: env FOLDSIM_PP_ROWS=balanced foldsim --srcs top.f --top Top --out %t/n --static --state-in-ram Node::2 --state-in-ram-pp --state-scratch-bits 0 --pp-idle-skip Node Src Sink > %t/n.log 2>&1
