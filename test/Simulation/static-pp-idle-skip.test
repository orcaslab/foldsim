# RUN: env FOLDSIM_PP_ROWS=balanced foldsim --srcs top.f --top Top --out %t/e --static --nest --modulo --state-in-ram Node::4 --state-in-ram-pp --state-scratch-bits 0 --page-engines 4 --page-engines-pp --pp-dirty-writeback --pp-idle-skip Node Src Sink > %t/e.log 2>&1
# RUN: FileCheck %s --check-prefix=LOG < %t/e.log
