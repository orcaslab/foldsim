# RUN: %t/cb/obj/Vtb +verilator+rand+reset+0 +verilator+seed+7 +lo=1 +hi=40 +stall=20 +bubble=20 | FileCheck %s
# RUN: %t/cb/obj/Vtb +verilator+rand+reset+0 +verilator+seed+8 +lo=3 +hi=20 +full=20 +bubble=10 | FileCheck %s
# Four instances (Driver/Inputs/fold_hbm): no L, an entry per instance.
# RUN: cd %S/../Driver/Inputs/fold_hbm
# RUN: foldsim --srcs top.f --top Top --out %t/few --static --fold-store-stream Leaf > %t/few.log 2>&1
# RUN: FileCheck %s --check-prefix=FEW < %t/few.log
# RUN: python3 %S/Inputs/vmem_bind.py %t/few/foldsim_sim.json %t/few
# RUN: %verilator --binary --timing -Wno-fatal -Wno-lint --x-initial unique -I%t/few --top-module tb -Mdir %t/few/obj %S/Inputs/tb_vmem_multi.sv top.sv %t/few/foldsim_sim.sv > %t/few/build.log 2>&1
# RUN: %t/few/obj/Vtb +verilator+rand+reset+0 +verilator+seed+9 +lo=1 +hi=30 +stall=20 | FileCheck %s
# RUN: %t/few/obj/Vtb +verilator+rand+reset+0 +verilator+seed+10 +lo=5 +hi=60 +full=30 | FileCheck %s
# ALL: fold-store-stream: Leaf: landing ring of 8 entries (16 instances
# ALL: fold-store-hbm: Leaf: 4 stores, 39344 bits in HBM; {{.*}}landing rings 4 of 8 entries
# IR-DAG: %fold3_store_landing = seq.firmem 1, 1, old, undefined : <8 x 600
# IR-DAG: %fold2_store_landing = seq.firmem 1, 1, old, undefined : <8 x 1
# IR-DAG: %fold3_store_lmeta = seq.firmem 1, 1, old, undefined : <8 x
# RING: fold-store-stream: Leaf: landing ring of 2 entries (16 instances
# RING: vmem-rings: Leaf: 4 read buffers as rings of 2 entries
# RING: fold-store-hbm: Leaf: 4 stores, 39344 bits in HBM; landing and read buffers 1314 bits on chip {{.*}}landing rings 4 of 2 entries
# RIR-NOT: _rdata = seq.firmem
# RIR-NOT: _lvalid
# RIR-DAG: %fold3_store_landing = seq.firmem 1, 1, old, undefined : <2 x 600
# RIR-DAG: %fold3_store_ring = seq.firmem 0, 1, undefined, undefined : <2 x 600
# FR: II = 67
# FR: fold-store-stream: Leaf: landing ring of 2 entries (16 instances
# FR: vmem-rings: Leaf: 4 read buffers as rings of 2 entries (window 2, 16 instances, 16 prefetches a frame, lead 4)
# FRIR-NOT: _store_pending =
# FRIR-NOT: _store_rdata = seq.firmem
# FRIR: %fold{{[0-9]}}_store_ring = seq.firmem
# F0IR: %fold0_store_pending = seq.firreg {{.*}} : i16
# CB: fold-store-stream: Leaf: a landing entry per instance
# CB: vmem-rings: Leaf: 4 read buffers as rings of
# CB: fold-store-stream: Leaf_copy1: a landing entry per instance
# FEW: fold-store-stream: Leaf: a landing entry per instance
# FEW: fold-store-hbm: Leaf: 2 stores, 224 bits in HBM
# FAST: {{^}}MATCH 196 cycles in 4400 host cycles
# CHECK: {{^}}MATCH
