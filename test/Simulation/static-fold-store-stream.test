# RUN: FileCheck %s --check-prefix=F0IR < %t/f0/foldsim_sim.mlir
# Two copies of 8 instances with bubbles (a landing entry per instance), rings.
# RUN: foldsim --srcs top.f --top Top --out %t/cb --static --modulo --min-ii 64 --fold-store-stream --vmem-rings 4 --copies Leaf:2 --bubbles Leaf > %t/cb.log 2>&1
# RUN: FileCheck %s --check-prefix=CB < %t/cb.log
