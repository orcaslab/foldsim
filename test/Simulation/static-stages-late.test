# RUN: %verilator --binary --timing -Wno-fatal -Wno-lint --x-initial unique --top-module tb -DBUBBLES -Mdir %t/rd8/obj %S/Inputs/tb_late.sv leaf.sv top_ready.sv %t/rd8/foldsim_sim.sv > %t/rd8/build.log 2>&1
