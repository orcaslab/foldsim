# With bubbles; with no scratch (everything streams); without a storage rule (URAM288: a share of 512).
# RUN: env FOLDSIM_PP_ROWS=balanced foldsim --srcs top128.f --top Top --out %t/b128 --static --state-in-ram Leaf::8 --state-in-ram-pp --storage Leaf:sir=block --state-scratch-bits 40000 --state-scratch-fixed --bubbles --modulo Leaf > %t/b128.log 2>&1
