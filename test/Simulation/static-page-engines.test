# RUN: %verilator --binary --timing -Wno-fatal -Wno-lint --x-initial unique --top-module tb -I%t/odd -DVM1 -Mdir %t/odd/obj %S/Inputs/tb_linkhbm.sv top.sv %t/odd/foldsim_sim.sv > %t/odd/build.log 2>&1
