# RUN: %verilator --binary --timing -Wno-fatal -Wno-lint --top-module tb -I%t/nest -DBUBBLES -Mdir %t/nest/obj %S/Inputs/tb_pages.sv top.sv %t/nest/foldsim_sim.sv > %t/nest/build.log 2>&1
