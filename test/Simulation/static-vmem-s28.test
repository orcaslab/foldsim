# Two SLR groups (the leaves' two copies), --room-regions and --physical-domains: each group gets its own region
# and bus, and every unit sits in its class's domain module inside its group's module.
# RUN: foldsim --srcs top.f --top Top --out %t/two --static --virtual-memories ram --vmem-controller s28 --ready-ahead --room-ahead --room-regions --copies Leaf:2 --slr-groups --slr-count 2 --slr-assign Leaf:0,Leaf_copy1:1 --slr-group-control --slr-group-reset --slr-group-local 1000 --slr-group-own 1000 --slr-group-env --physical-domains Leaf > %t/two.log 2>&1
# RUN: FileCheck %s --check-prefix=TWO < %t/two.log
