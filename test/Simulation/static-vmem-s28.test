# REQUIRES: verilator
# --vmem-controller s28 (fold-static vmem-s28, S28 stage A): the class memories' controller side built into the
# simulator per SLR group. Memory k's type adapter (foldsim_vmem_adapter) keeps its native vm<k> port inside the
# simulator; its class's local switch (foldsim_vmem_lsw) and its domain root's central switch (foldsim_vmem_csw)
# follow, each instantiated in the class's (the root's) domain and group; the vm<k> ports give way to each root's
# bus s28r<g>_<j>_* for the kernel's region controller of group g. tb_s28.sv serves the buses with a behavioural
# region controller (random latency, request stalls, hold) on the units of shell/rtl: exact against the target.
#
# One group: the four leaves' RAM, one class (Leaf x4), one local and one central switch.
# RUN: rm -rf %t && mkdir -p %t && cd %S/../Driver/Inputs/vmem
# RUN: foldsim --srcs top.f --top Top --out %t/one --static --virtual-memories ram --vmem-controller s28 --ready-ahead --room-ahead Leaf > %t/one.log 2>&1
# RUN: FileCheck %s --check-prefix=ONE < %t/one.log
# ONE: foldsim-fold-static: vmem-s28: 1 memories:
# ONE-NEXT: region 0: 1 classes, 1 central switches
# ONE-NEXT: csw 0 (root Leaf): Leaf
# ONE: foldsim: vmem s28: region 0 (-): 1 central switches, 1 memories, 4096 bytes
# The vm0 ports are gone; the bus's are there, and the units with the port's widths and the class's parameters.
# RUN: FileCheck %s --check-prefix=SV < %t/one/foldsim_sim.sv
# SV-LABEL: module foldsim_sim(
# SV-NOT: vm0_
# SV-DAG: s28r0_0_req_rdy,
# SV-DAG: s28r0_0_hold,
# SV-DAG: s28r0_0_rsp_v,
# SV-DAG: input {{ *}}[527:0] s28r0_0_rsp_word,
# SV-DAG: output {{ *}}s28r0_0_req_v,
# SV-DAG: output {{ *}}[596:0] s28r0_0_req_word,
# SV-DAG: output {{ *}}s28r0_0_idle
# SV: foldsim_vmem_adapter #(
# SV-NEXT: .IW(2),
# SV-NEXT: .AW(4),
# SV-NEXT: .DW(8),
# SV-NEXT: .MW(1),
# SV-NEXT: .LANES(1),
# SV-NEXT: .MEM_W(4),
# SV-NEXT: .INST_W(2),
# SV-NEXT: .ROW_W(4)
# SV-NEXT: ) s28_ad_vm0_Leaf (
# SV: foldsim_vmem_lsw #(
# SV-NEXT: .N(1),
# SV-NEXT: .CLS(0),
# SV: ) s28_lsw_Leaf (
# SV: foldsim_vmem_csw #(
# SV-NEXT: .K(1),
# SV-NEXT: .ICLSM(64'd1),
# SV-NEXT: .MEM_W(4),
# SV-NEXT: .INST_W(2),
# SV-NEXT: .ROW_W(4)
# SV-NEXT: ) s28_csw_r0_0 (
# The kernel's header: the region, its bus, its memory table (class, memory, instances, row bytes' log2, data bits,
# lin offset); no per-memory controllers.
# RUN: FileCheck %s --check-prefix=VH < %t/one/foldsim_sim.vh
# VH: `define FOLDSIM_S28
# VH-NEXT: `define FOLDSIM_S28_REGIONS 1
# VH-NEXT: `define FOLDSIM_S28_INST_W 2
# VH-NEXT: `define FOLDSIM_S28_ROW_W 4
# VH-NEXT: `define FOLDSIM_S28_MEM_W 4
# VH-NEXT: `define FOLDSIM_S28_REQ_W 597
# VH-NEXT: `define FOLDSIM_S28_RSP_W 528
# VH-NEXT: `define FOLDSIM_S28_REPEAT(f,s) `f(0)
# VH: `define FOLDSIM_S28_R0_NIN 1
# VH-NEXT: `define FOLDSIM_S28_R0_IN_REPEAT(f,s) `f(0, 0)
# VH-NEXT: `define FOLDSIM_S28_R0_ICLSM '{64'h1}
# VH-NEXT: `define FOLDSIM_S28_R0_NE 1
# VH-NEXT: `define FOLDSIM_S28_R0_E_CLS '{0}
# VH-NEXT: `define FOLDSIM_S28_R0_E_MEM '{0}
# VH-NEXT: `define FOLDSIM_S28_R0_E_INST '{4}
# VH-NEXT: `define FOLDSIM_S28_R0_E_RB '{6}
# VH-NEXT: `define FOLDSIM_S28_R0_E_DW '{8}
# VH-NEXT: `define FOLDSIM_S28_R0_E_LANES '{1}
# VH-NEXT: `define FOLDSIM_S28_R0_E_OFF '{64'h0}
# VH: `define FOLDSIM_S28_R0_BYTES 64'h1000
# VH-NOT: FOLDSIM_VMEM_COUNT
# Without SLR groups the region controller sits with the level: no path crosses.
# RUN: FileCheck %s --check-prefix=SLL1 < %t/one/sll/sll.txt
# SLL1: memory paths (S28): 3, 0 crossing an SLR boundary (0 bits)
# RUN: %verilator --binary --timing -Wno-fatal -Wno-lint -DSIMULATION --top-module tb -I%S/../../shell/rtl -I%t/one -Mdir %t/one/obj %S/Inputs/tb_s28.sv top.sv %t/one/foldsim_sim.sv %S/../../shell/rtl/foldsim_vmem_adapter.sv %S/../../shell/rtl/foldsim_vmem_lsw.sv %S/../../shell/rtl/foldsim_vmem_csw.sv > %t/one/build.log 2>&1
